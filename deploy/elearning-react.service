# systemd unit: runs the e-learning server, starts it at boot and restarts it if it stops.
#   sudo cp deploy/elearning-react.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now elearning-react
#   journalctl -u elearning-react -f        (its log)
[Unit]
Description=Tribe of Abraham e-learning (xAPI quiz server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elearning
Group=elearning
WorkingDirectory=/srv/elearning-react
Environment=NODE_ENV=production
# .env holds the LRS endpoint, key and secret (readable by the elearning user only)
ExecStart=/usr/bin/node --env-file-if-exists=.env server/index.js
Restart=on-failure
RestartSec=3

# It only needs to read its own folder and talk on the network
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
