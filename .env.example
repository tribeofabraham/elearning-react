# Copy this file to .env and fill it in. Never commit .env.
#
# The LRS the server records attempts in (SCORM Cloud, or any xAPI 1.0.3 LRS):
#   SCORM Cloud > LRS > Activity Providers > Add (or use an existing one).
#   Use the endpoint shown on the LRS page plus that Activity Provider's key and secret.
# Leave these blank to use the mock LRS (statements are printed in the server's console).
LRS_ENDPOINT=https://cloud.scorm.com/lrs/YOUR_APP_ID/
LRS_KEY=
LRS_SECRET=

# Quizzes are recorded as activities under this IRI: <ACTIVITY_BASE>/<quiz id>
ACTIVITY_BASE=https://tribeofabraham.com/xapi/elearning-react

PORT=3030
