# The Ragamuffin Studios copy: `vite build --mode studios` (npm run build:studios). No secrets here;
# the LRS key stays in the server's .env. See src/brand.js and scripts/brand-static.mjs.
VITE_BRAND=studios
VITE_BRAND_NAME=Ragamuffin Studios
VITE_APP_NAME=Interactives
VITE_BRAND_HOME=https://ragamuffinstudios.com
VITE_ACTIVITY_BASE=https://ragamuffinstudios.com/xapi/elearning
VITE_SITE=https://learn.ragamuffinstudios.com
VITE_CMI5_URL=https://ragamuffinstudios.com/cmi5/
VITE_OG_IMAGE=https://ragamuffinstudios.com/images/site/og.jpg
VITE_LOGO=studios-logo.svg
VITE_BYLINE=Ragamuffin Studios
VITE_OUR=our
# SCORM Cloud public invitations for the Studios courses (empty: that delivery says "on request")
# The authoring-tool course: the Tribe of Abraham one (not rebuilt for Studios), in a new window
VITE_LECTORA_INVITE=https://app.cloud.scorm.com/sc/InvitationConfirmEmail?publicInvitationId=2563ee22-a93b-4c07-be53-68e166974f81
VITE_LECTORA_NEW_WINDOW=on
VITE_CMI5_INVITE=https://app.cloud.scorm.com/sc/InvitationConfirmEmail?publicInvitationId=38269cc4-5d00-456a-80e8-59baebaa1d4f
VITE_FOOTER=Ragamuffin Studios · <a href="https://ragamuffinstudios.com">ragamuffinstudios.com</a> · <a href="https://ragamuffinstudios.com/checkup/">Get a free learning tool checkup</a>
